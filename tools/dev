#!/bin/sh
set -eu
NEONMIX_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export CARGO_HOME="$NEONMIX_ROOT/.local/cargo"
export CARGO_TARGET_DIR="$NEONMIX_ROOT/target"
export TMPDIR="$NEONMIX_ROOT/.local/tmp"
export TMP="$TMPDIR" TEMP="$TMPDIR"
export UV_CACHE_DIR="$NEONMIX_ROOT/.local/uv"
export npm_config_cache="$NEONMIX_ROOT/.local/npm"
export PYTHONPYCACHEPREFIX="$NEONMIX_ROOT/.local/pycache"
export UV_PYTHON_INSTALL_DIR="$NEONMIX_ROOT/.local/python"
export MACOSX_DEPLOYMENT_TARGET="${MACOSX_DEPLOYMENT_TARGET:-14.6}"
export XDG_CACHE_HOME="$NEONMIX_ROOT/.local/cache"
mkdir -p "$CARGO_HOME" "$TMPDIR" "$UV_CACHE_DIR" "$npm_config_cache" "$XDG_CACHE_HOME"
# Read the already-installed pinned toolchain; do not mutate the global rustup cache.
if command -v rustup >/dev/null 2>&1; then
  NEONMIX_RUSTC=$(rustup which --toolchain 1.95.0 rustc)
  PATH="$(dirname "$NEONMIX_RUSTC"):$PATH"
  export PATH
fi
if [ "$(uname -s)" = Linux ] && [ -d "$NEONMIX_ROOT/.local/native/root" ]; then
  NEONMIX_NATIVE="$NEONMIX_ROOT/.local/native/root"
  NEONMIX_MULTIARCH=$(cc -dumpmachine)
  export PKG_CONFIG_PATH="$NEONMIX_NATIVE/usr/lib/$NEONMIX_MULTIARCH/pkgconfig:$NEONMIX_NATIVE/usr/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
  export LIBRARY_PATH="$NEONMIX_NATIVE/usr/lib/$NEONMIX_MULTIARCH${LIBRARY_PATH:+:$LIBRARY_PATH}"
  export LD_LIBRARY_PATH="$NEONMIX_NATIVE/usr/lib/$NEONMIX_MULTIARCH${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  export NEONMIX_CJK_FONT="$NEONMIX_NATIVE/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
fi
cd "$NEONMIX_ROOT"
if [ "$(uname -s)" = Darwin ] && [ -d "$NEONMIX_ROOT/.local/gstreamer/prefix" ]; then
  NEONMIX_GST="$NEONMIX_ROOT/.local/gstreamer/prefix"
  export PKG_CONFIG_PATH="$NEONMIX_ROOT/.local/gstreamer/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
  # Resolve extracted framework dependencies without overriding libraries already
  # installed for developer tools (Git/Python may need newer libintl/libexpat).
  export DYLD_FALLBACK_LIBRARY_PATH="$NEONMIX_GST/lib${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"
  export GST_PLUGIN_SYSTEM_PATH_1_0="$NEONMIX_ROOT/.local/gstreamer/plugins"
  export GST_PLUGIN_PATH_1_0="" GST_PLUGIN_PATH=""
  export GST_PLUGIN_SCANNER="$NEONMIX_GST/libexec/gstreamer-1.0/gst-plugin-scanner"
  export GST_REGISTRY="$NEONMIX_ROOT/.local/gstreamer/registry.bin"
  export PATH="$NEONMIX_GST/bin:$PATH"
fi
if [ -d "$NEONMIX_ROOT/.local/airplay/plugins" ]; then
  export NEONMIX_AIRPLAY_RUNTIME="$NEONMIX_ROOT/.local/airplay"
fi
exec "$@"
