#!/bin/sh
set -eu
NEONMIX_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "$#" -eq 0 ]; then
  echo 'usage: tools/credential_migrate <test|build|run|clippy|fmt|tree> [cargo arguments]' >&2
  exit 2
fi
NEONMIX_COMMAND=$1
shift
exec "$NEONMIX_ROOT/tools/dev" env CARGO_TARGET_DIR="$NEONMIX_ROOT/target/credential-migrate" \
  cargo "$NEONMIX_COMMAND" --manifest-path "$NEONMIX_ROOT/apps/credential-migrate/Cargo.toml" "$@"
