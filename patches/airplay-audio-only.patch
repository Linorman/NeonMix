+/* Nonblocking sends have one absolute two-second budget. Restore the accepted
+ * socket's blocking mode before returning; receive behavior stays unchanged. */
+static uint64_t transport_millis(void) {
+#ifdef WIN32
+    return GetTickCount64();
+#else
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000 + (uint64_t)ts.tv_nsec / 1000000;
+#endif
+}
+static int transport_nonblocking(int fd, int enabled) {
+#ifdef WIN32
+    u_long mode = enabled; return ioctlsocket(fd, FIONBIO, &mode);
+#else
+    int mode = enabled; return ioctl(fd, FIONBIO, &mode);
+#endif
+}
+static const char *transport_send(int fd, const char *data, int bytes, unsigned *sent) {
+    *sent = 0;
+    if (transport_nonblocking(fd, 1)) return "send_error";
+    const char *outcome = "complete";
+    uint64_t deadline = transport_millis() + 2000;
+    while (*sent < (unsigned)bytes) {
+        uint64_t now = transport_millis();
+        if (now >= deadline) { outcome = "send_timeout"; break; }
+        uint64_t remaining = deadline - now;
+        struct timeval timeout = {(long)(remaining / 1000), (long)((remaining % 1000) * 1000)};
+        fd_set writable; FD_ZERO(&writable); FD_SET(fd, &writable);
+        int ready = select(fd + 1, NULL, &writable, NULL, &timeout);
+        if (!ready) { outcome = "send_timeout"; break; }
+        if (ready < 0) {
+            if (SOCKET_GET_ERROR() == SOCKET_ERRORNAME(EINTR)) continue;
+            outcome = "send_error"; break;
+        }
+        int ret = send(fd, data + *sent, bytes - (int)*sent, 0);
+        if (!ret) { outcome = "send_closed"; break; }
+        if (ret < 0) {
+            int error = SOCKET_GET_ERROR();
+            if (error == SOCKET_ERRORNAME(EINTR) || error == SOCKET_ERRORNAME(EAGAIN) || error == SOCKET_ERRORNAME(EWOULDBLOCK)) continue;
+            outcome = "send_error"; break;
+        }
+        *sent += (unsigned)ret;
+    }
+    if (transport_nonblocking(fd, 0)) outcome = "send_error";
+    return outcome;
 }
 
