+    const char *safe_method = "OTHER", *route = "other";
+    const char *methods[] = {"GET", "POST", "PUT", "OPTIONS", "SETUP", "RECORD", "GET_PARAMETER", "SET_PARAMETER", "FLUSH", "TEARDOWN", "ANNOUNCE"};
