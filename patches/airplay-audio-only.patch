+    else if (!strcmp(url, "/pair-setup-pin")) route = "pair_setup_pin";
+    else if (!strcmp(url, "/pair-setup")) route = "pair_setup";
+    else if (!strcmp(url, "/pair-verify")) route = "pair_verify";
+    else if (!strcmp(url, "/fp-setup")) route = "fp_setup";
+    else if (!strcmp(url, "/feedback")) route = "feedback";
+    else if (!strcmp(url, "/audioMode")) route = "audio_mode";
+    else if (!strcmp(url, "/setRateAnchorTime")) route = "rate_anchor";
+    else if (!strcmp(url, "/setRate")) route = "set_rate";
+    else if (!strcmp(url, "/setProperty")) route = "set_property";
+    else if (!strcmp(url, "*")) route = "options";
+    else if (!strncmp(url, "rtsp://", 7)) route = "audio";
+    else if (!strcmp(url, "/play") || !strcmp(url, "/reverse") || !strcmp(url, "/action") || !strcmp(url, "/photo")) route = "video";
+    unsigned status = (unsigned)http_response_get_status(response);
+    if (raop->callbacks.protocol_trace) raop->callbacks.protocol_trace(raop->callbacks.cls, safe_method, route, status);
+    if (raop->callbacks.protocol_transport) {
