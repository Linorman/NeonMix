+//=============================================================================
+#pragma code_seg("PAGE")
+NTSTATUS CMiniportWaveRTStream::RegisterNotificationEvent(_In_ PKEVENT event)
+{
+    PAGED_CODE();
+    if (event == NULL) { return STATUS_INVALID_PARAMETER; }
+    auto entry = (NotificationListEntry*)ExAllocatePool2(POOL_FLAG_NON_PAGED, sizeof(NotificationListEntry), MINWAVERTSTREAM_POOLTAG);
+    if (entry == NULL) { return STATUS_INSUFFICIENT_RESOURCES; }
+    entry->NotificationEvent = event;
+    KIRQL oldIrql;
+    KeAcquireSpinLock(&m_PositionSpinLock, &oldIrql);
+    ULONG count = 0;
+    for (auto current=m_NotificationList.Flink; current!=&m_NotificationList; current=current->Flink)
+    {
+        auto existing=CONTAINING_RECORD(current,NotificationListEntry,ListEntry);
+        if (existing->NotificationEvent==event || ++count>=2)
+        {
+            KeReleaseSpinLock(&m_PositionSpinLock,oldIrql);
+            ExFreePoolWithTag(entry,MINWAVERTSTREAM_POOLTAG);
+            return STATUS_INVALID_PARAMETER;
+        }
+    }
+    InsertTailList(&m_NotificationList,&entry->ListEntry);
+    KeReleaseSpinLock(&m_PositionSpinLock,oldIrql);
+    return STATUS_SUCCESS;
+}
+
+//=============================================================================
+#pragma code_seg("PAGE")
+NTSTATUS CMiniportWaveRTStream::UnregisterNotificationEvent(_In_ PKEVENT event)
+{
+    PAGED_CODE();
+    KIRQL oldIrql;
+    KeAcquireSpinLock(&m_PositionSpinLock,&oldIrql);
+    for (auto current=m_NotificationList.Flink; current!=&m_NotificationList; current=current->Flink)
+    {
+        auto entry=CONTAINING_RECORD(current,NotificationListEntry,ListEntry);
+        if (entry->NotificationEvent==event)
+        {
+            RemoveEntryList(current);
+            KeReleaseSpinLock(&m_PositionSpinLock,oldIrql);
+            ExFreePoolWithTag(entry,MINWAVERTSTREAM_POOLTAG);
+            return STATUS_SUCCESS;
+        }
+    }
+    KeReleaseSpinLock(&m_PositionSpinLock,oldIrql);
+    return STATUS_NOT_FOUND;
+}
