-#pragma code_seg("PAGE")
-VOID CMiniportWaveRTStream::FreeBufferWithNotification
-(
-    _In_        PMDL    Mdl_,
-    _In_        ULONG   Size_
-)
-{
-    UNREFERENCED_PARAMETER(Size_);
