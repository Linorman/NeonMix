+_IRQL_requires_max_(PASSIVE_LEVEL)
+NTSTATUS CMiniportWaveRTStream::GetPacketCount
+(
+    _Out_ ULONG *pPacketCount
+)
+{
+    ASSERT(pPacketCount);
+
+    // The call must be from event driven mode
+    if(m_ulNotificationsPerBuffer == 0)
