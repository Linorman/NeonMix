+/// Tracks the concrete target even when PipeWire leaves the stream in Paused state.
+pub struct PinnedDeviceMonitor {
+    _sync_listener: CoreListener,
+    _registry_listener: RegistryListener,
+    _registry: RegistryRc,
+}
+
+impl PinnedDeviceMonitor {
+    pub(super) fn new(
+        core: &CoreRc,
+        registry: RegistryRc,
+        serial: u32,
+        error_callback: ErrorCallbackArc,
+        invalidated: Arc<AtomicBool>,
+    ) -> Result<Self, pw::Error> {
+        let target = Rc::new(Cell::new(None));
+        let added_target = target.clone();
+        let removed_target = target.clone();
+        let removed_error = error_callback.clone();
+        let removed_invalidated = invalidated.clone();
+        let registry_listener = registry.add_listener_local()
+            .global(move |global| {
+                if global.type_ == ObjectType::Node && global.props.is_some_and(|props| {
+                    props.get(*pw::keys::OBJECT_SERIAL).and_then(|v| v.parse::<u32>().ok()) == Some(serial)
+                }) {
+                    added_target.set(Some(global.id));
+                }
+            })
+            .global_remove(move |id| {
+                if removed_target.get() == Some(id) && !removed_invalidated.swap(true, Ordering::Relaxed) {
+                    emit_error(&removed_error, ErrorKind::DeviceNotAvailable.into());
+                }
+            })
+            .register();
+        let pending = core.sync(0)?;
+        let sync_listener = core.add_listener_local().done(move |id, seq| {
+            if id == PW_ID_CORE && seq == pending && target.get().is_none()
+                && !invalidated.swap(true, Ordering::Relaxed) {
+                emit_error(&error_callback, ErrorKind::DeviceNotAvailable.into());
+            }
+        }).register();
+        Ok(Self { _sync_listener: sync_listener, _registry_listener: registry_listener, _registry: registry })
+    }
+}
