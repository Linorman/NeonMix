+    #[test]
+    fn test_republish_cancels_old_goodbye_for_service_pair_only() {
+        let signal = UdpSocket::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+        let signal_addr = signal.local_addr().unwrap();
+        signal.set_nonblocking(true).unwrap();
+        let port = UdpSocket::bind((Ipv4Addr::LOCALHOST, 0))
+            .unwrap()
+            .local_addr()
+            .unwrap()
+            .port();
+        let (sender, _receiver) = flume::bounded(100);
+        let mut daemon = super::Zeroconf::new(
+            mio::net::UdpSocket::from_std(signal),
+            mio::Poll::new().unwrap(),
+            port,
+            sender,
+            signal_addr,
+        );
+        // Use loopback and a private port; never touch the running room.
+        let loopback = my_ip_interfaces(true)
+            .into_iter()
+            .find(|intf| intf.ip() == IpAddr::V4(Ipv4Addr::LOCALHOST))
+            .unwrap();
+        let index = loopback.index.unwrap();
+        daemon.my_intfs.retain(|key, _| *key == index);
+        daemon.dns_registry_map.retain(|key, _| *key == index);
+        let service = |kind, name, host| {
+            let mut info = ServiceInfo::new(kind, name, host, "127.0.0.1", 8080, None).unwrap();
+            info.set_interfaces(vec![IfKind::Addr(IpAddr::V4(Ipv4Addr::LOCALHOST))]);
+            info
+        };
+        let raop = service("_raop._tcp.local.", "entry-a", "entry-a.local.");
+        let airplay = service("_airplay._tcp.local.", "entry-a", "entry-a.local.");
+        let other = service("_airplay._tcp.local.", "entry-b", "entry-b.local.");
+        for info in [&raop, &airplay, &other] {
+            daemon.register_service(info.clone());
+        }
+        for info in [&raop, &airplay, &other] {
+            let (sender, receiver) = flume::bounded(1);
+            daemon.exec_command_unregister(false, info.get_fullname().to_lowercase(), sender);
+            assert!(matches!(
+                receiver.recv().unwrap(),
+                super::UnregisterStatus::OK
+            ));
+        }
+        let goodbyes = |daemon: &super::Zeroconf| {
+            daemon
+                .retransmissions
+                .iter()
+                .filter_map(|rerun| {
+                    if let super::Command::UnregisterResend(_, _, _, fullname, _) = &rerun.command {
+                        Some(fullname.clone())
+                    } else {
+                        None
+                    }
+                })
+                .collect::<Vec<_>>()
+        };
+        let pending = goodbyes(&daemon);
+        assert!(pending.contains(&raop.get_fullname().to_lowercase()));
+        assert!(pending.contains(&airplay.get_fullname().to_lowercase()));
+        assert!(pending.contains(&other.get_fullname().to_lowercase()));
+        // No sleep: reverse well inside the 120ms resend window. Registering
+        // either sibling invalidates all old goodbye packets for their host.
+        daemon.register_service(raop.clone());
+        let remaining = goodbyes(&daemon);
+        assert!(!remaining.is_empty());
+        assert!(remaining
+            .iter()
+            .all(|name| name == &other.get_fullname().to_lowercase()));
+        daemon.register_service(airplay.clone());
+        assert_eq!(goodbyes(&daemon), remaining);
+        assert_eq!(daemon.my_services.len(), 2);
+        // Repeated withdrawal is confirmed absent, rather than an error.
+        let (sender, receiver) = flume::bounded(1);
+        daemon.exec_command_unregister(false, other.get_fullname().to_lowercase(), sender);
+        assert!(matches!(
+            receiver.recv().unwrap(),
+            super::UnregisterStatus::NotFound
+        ));
     }
 
