+    #[test]
+    fn scoped_reflected_local_address_does_not_rename_hostname() {
+        let signal = UdpSocket::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+        let signal_addr = signal.local_addr().unwrap();
+        signal.set_nonblocking(true).unwrap();
+        let port = UdpSocket::bind((Ipv4Addr::LOCALHOST, 0))
+            .unwrap()
+            .local_addr()
+            .unwrap()
+            .port();
+        let (sender, _receiver) = flume::bounded(100);
+        let mut daemon = super::Zeroconf::new(
+            mio::net::UdpSocket::from_std(signal),
+            mio::Poll::new().unwrap(),
+            port,
+            sender,
+            signal_addr,
+        );
+        let host = "scoped-reflection.local.";
+        let own = "fe80::100".parse::<IpAddr>().unwrap();
+        let other_nic = "fe80::200".parse::<IpAddr>().unwrap();
+        daemon.my_intfs.clear();
+        for (name, index, ip) in [("en0", 18, own), ("en11", 32, other_nic)] {
+            daemon.my_intfs.insert(
+                index,
+                MyIntf {
+                    name: name.into(),
+                    index,
+                    addrs: HashSet::from([test_ifaddr_v6(match ip {
+                        IpAddr::V6(ip) => ip,
+                        _ => unreachable!(),
+                    })]),
+                    max_packet_size_v4: 1500,
+                    max_packet_size_v6: 1500,
+                },
+            );
+        }
+        let service = ServiceInfo::new(
+            "_test._tcp.local.",
+            "reflection",
+            host,
+            "fe80::100,fe80::200",
+            7000,
+            None,
+        )
+        .unwrap();
+        daemon
+            .my_services
+            .insert(service.get_fullname().into(), service);
+        let mut registry = crate::service_info::DnsRegistry::new();
+        let mut probe = crate::service_info::Probe::new(crate::current_time_millis());
+        let intf_id = InterfaceId {
+            name: "en0".into(),
+            index: 18,
+        };
+        probe.insert_record(Box::new(DnsAddress::new(
+            host,
+            RRType::AAAA,
+            CLASS_IN,
+            120,
+            own,
+            intf_id.clone(),
+        )));
+        registry.probing.insert(host.into(), probe);
+        daemon.dns_registry_map.clear();
+        daemon.dns_registry_map.insert(18, registry);
+        let incoming = |ip| {
+            let mut out = DnsOutgoing::new(FLAGS_QR_RESPONSE | FLAGS_AA);
+            out.add_answer_at_time(
+                DnsAddress::new(host, RRType::AAAA, CLASS_IN, 120, ip, intf_id.clone()),
+                0,
+            );
+            DnsIncoming::new(out.to_data_on_wire(1500, false).remove(0), intf_id.clone()).unwrap()
+        };
+        daemon.conflict_handler(&incoming(other_nic), 18);
+        assert!(daemon.dns_registry_map[&18].name_changes.is_empty());
+        assert!(daemon.dns_registry_map[&18].probing.contains_key(host));
+        // A different remote publisher still causes the original conflict.
+        daemon.conflict_handler(&incoming("fe80::999".parse().unwrap()), 18);
+        assert!(!daemon.dns_registry_map[&18].name_changes.is_empty());
+    }
