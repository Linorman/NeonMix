+    #[test]
+    fn scoped_link_local_publication_uses_interface_ownership() {
+        use std::{collections::HashSet, net::IpAddr};
+        let service = ServiceInfo::new(
+            "_test._tcp.local.",
+            "scoped",
+            "scoped.local.",
+            "fe80::100,fe80::200,fe80::1,::1,2001:db8:1::10,fd00:1::10,fd00:2::10,192.0.2.10",
+            7000,
+            None,
+        )
+        .unwrap();
+        let cases = [
+            (
+                "en0",
+                18,
+                vec![("fe80::100", 64), ("2001:db8:1::1", 64), ("fd00:1::1", 64)],
+                vec!["fe80::100", "2001:db8:1::10", "fd00:1::10"],
+            ),
+            (
+                "en11",
+                32,
+                vec![("fe80::200", 64), ("fd00:2::1", 64)],
+                vec!["fe80::200", "fd00:2::10"],
+            ),
+            (
+                "lo0",
+                1,
+                vec![("fe80::1", 64), ("::1", 128)],
+                vec!["fe80::1", "::1"],
+            ),
+        ];
+        for (name, index, owned, expected) in cases {
+            let intf = scoped_test_interface(name, index, &owned);
+            let actual: HashSet<IpAddr> =
+                service.get_addrs_on_my_intf_v6(&intf).into_iter().collect();
+            let expected: HashSet<IpAddr> =
+                expected.into_iter().map(|a| a.parse().unwrap()).collect();
+            assert_eq!(actual, expected, "publication on {name}");
+        }
+    }
