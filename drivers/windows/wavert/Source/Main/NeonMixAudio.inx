[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 09/30/2026, 0.1.0.0
CatalogFile = NeonMixAudio.cat
PnpLockDown = 1

[SourceDisksNames]
222="NEONMIX Driver Disk","",222

[SourceDisksFiles]
NeonMixAudio.sys=222

[Manufacturer]
%MfgName%=NEONMIX,NT$ARCH$.10.0...26100

[NEONMIX.NT$ARCH$.10.0...26100]
%NEONMIX_SA.DeviceDesc%=NEONMIX_SA, ROOT\NeonMixAudio

[DestinationDirs]
NEONMIX_SA.CopyList=13 ; 13=Package's DriverStore directory

;======================================================
; NEONMIX_SA
;======================================================
[NEONMIX_SA.CopyList]
NeonMixAudio.sys

[NEONMIX_SA.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,NeonMixAudio.sys

;
; For demo only, please review these power management settings for your architecture. 
;
HKR,PowerSettings,SingleComponentMultiFxStates,3,1,0,0,0  ; Turn on multi Fx support.
HKR,PowerSettings,ConservationIdleTime,3,3,0,0,0          ; 3 seconds for idle power management when on battery
HKR,PowerSettings,PerformanceIdleTime,3,3,0,0,0           ; 3 seconds for idle power management when on AC power
HKR,PowerSettings,IdlePowerState,3,3,0,0,0                ; go to D3 for idle power management

HKR,Drivers,SubClasses,,"wave,midi,mixer"

HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%NEONMIX_SA.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%NEONMIX_SA.DeviceDesc%

;======================================================
; Single virtual render endpoint
;======================================================
;======================================================
; render interfaces: speaker (internal)
;======================================================
[NEONMIX.I.WaveSpeaker]
AddReg=NEONMIX.I.WaveSpeaker.AddReg

[NEONMIX.I.WaveSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%NEONMIX.WaveSpeaker.szPname%

[NEONMIX.I.TopologySpeaker]
AddReg=NEONMIX.I.TopologySpeaker.AddReg

[NEONMIX.I.TopologySpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%NEONMIX.TopologySpeaker.szPname%

HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

; The following lines opt-in to pull mode.
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1
; Immutable product marker for Rust owned render selection, independent of names.
HKR,EP\0,%PKEY_NeonMix_OutputOwner%,,"com.neonmix.audio.virtual-output"

;======================================================
; NEONMIX_SA
;======================================================
[NEONMIX_SA.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=NEONMIX_SA.CopyList
AddReg=NEONMIX_SA.AddReg

[NEONMIX_SA.NT.Interfaces]
;
; Interfaces for speaker (internal) render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveSpeaker%, NEONMIX.I.WaveSpeaker
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveSpeaker%, NEONMIX.I.WaveSpeaker
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%, NEONMIX.I.WaveSpeaker
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologySpeaker%, NEONMIX.I.TopologySpeaker
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, NEONMIX.I.TopologySpeaker

;
; No capture endpoint is registered.
;

[NEONMIX_SA.NT.Services]
AddService=NeonMixAudio,0x00000002,NeonMixAudio_Service_Inst

[NeonMixAudio_Service_Inst]
DisplayName=%NeonMixAudio.SvcDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\NeonMixAudio.sys

[NEONMIX_SA.NT.HW]
AddReg = AUDIOHW.AddReg

[AUDIOHW.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; SDDL_DEVOBJ_SYS_ALL_ADM_RWX_WORLD_RWX_RES_RWX
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"


;======================================================
; WDF
;======================================================
[NEONMIX_SA.NT.Wdf]
KmdfService = NeonMixAudio, NEONMIX_SA_WdfSect
[NEONMIX_SA_WdfSect]
KmdfLibraryVersion = $KMDFVERSION$

;======================================================
; COMMON
;======================================================
[Strings]

;Non-localizable

KSNAME_WaveSpeaker="WaveSpeaker"
KSNAME_TopologySpeaker="TopologySpeaker"


Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME ="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"

KSNODETYPE_ANY   = "{00000000-0000-0000-0000-000000000000}"

PKEY_NeonMix_OutputOwner = "{1A50C7B0-B766-4E50-9DF8-3F49B6583BD1},2"
PKEY_AudioEndpoint_Association               = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"

;Localizable

ProviderName = "NeonMix"
MfgName      = "NeonMix"
MsCopyRight  = "NeonMix; driver base Copyright Microsoft Corporation"

NEONMIX_SA.DeviceDesc="NeonMix Virtual Output"
NeonMixAudio.SvcDesc="NeonMix Virtual Output Driver"

;; friendly names
NEONMIX.WaveSpeaker.szPname="NeonMix"
NEONMIX.TopologySpeaker.szPname="NeonMix"



